<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
<Loggers>
    <Root level="info">
        <AppenderRef ref="Console_Appenders"/>
        <AppenderRef ref="File_Appender"/>
    </Root>
</Loggers>
<Appenders>
    <Console name = "Console_Appenders" target="SYSTEM_OUT">
        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
    </Console>

    <RollingFile name = "File_Appender" fileName = "${sys:user.dir}/logs/${date:yyyy-MM-dd}/automation.log"
        filePattern = "${sys:user.dir}/logs/${date:yyyy-MM-dd}/automation-%d{yyyy-MM-dd}-%i.log">
        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n"/>
        <Policies>
            <TimeBasedTriggeringPolicy interval="1"/>
            <SizeBasedTriggeringPolicy size="10MB"/>
        </Policies>
    </RollingFile>
   
</Appenders>


</Configuration>